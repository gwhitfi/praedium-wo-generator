generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum ContactType {
  CONTRACTOR
  TENANT
  OTHER
}

enum PropertyType {
  HOUSE
  DUPLEX
  TOWNHOUSE
  CONDO
  APARTMENT
  COMMERCIAL
  LAND
}

enum WorkOrderStatus {
  DRAFT
  SENT
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum DeliveryMethod {
  EMAIL
  SMS
  PRINT
}

enum LineItemPriority {
  EMERGENCY
  HIGH
  MEDIUM
  LOW
}

enum WorkOrderEventType {
  // Office
  CREATED
  EDITED
  SENT
  CONTRACTOR_CHANGED
  COMPLETED_BY_OFFICE
  CANCELLED
  REOPENED
  CLOSED
  ARCHIVED
  RESTORED
  PHOTO_ADDED
  PHOTO_REMOVED
  ITEM_ADDED
  ITEM_REMOVED
  ITEM_EDITED
  AREA_ADDED
  AREA_REMOVED
  AREA_RENAMED
  STARTED // an in-house work order was started; nothing is sent
  // Contractor
  OPENED
  ITEM_CHECKED
  ITEM_UNCHECKED
  NOTE_SAVED
  COMPLETED_BY_CONTRACTOR
  VERIFIED
  // Email (Resend webhooks)
  EMAIL_DELIVERED // the contractor's work order email arrived
  EMAIL_BOUNCED // an email for this work order bounced or was marked as spam
}

enum EmailKind {
  WORK_ORDER // the work order link to the contractor
  TENANT_NOTICE
  CANCELLED
  COMPLETED // the contractor finished; goes to the office
  VERIFY_CODE // the contractor's 6-digit code
  ORGANIZATION_DELETED // the organization was scheduled for deletion; goes to its admins
}

enum EmailStatus {
  SENT // accepted by Resend
  DELIVERED
  BOUNCED
  COMPLAINED // marked as spam
  FAILED // Resend refused it
  SKIPPED // not sent: a suppressed address or over the daily limit
}

// One row per email Praedium tries to send (src/lib/emailLog.ts), so the office can see whether it arrived.
model EmailLog {
  id        String      @id @default(cuid())
  kind      EmailKind
  // Trimmed and lower-cased.
  to        String
  subject   String
  status    EmailStatus @default(SENT)
  // Resend's id for the email, which its webhook events carry.
  resendId  String?     @unique
  // Why it bounced, failed or was skipped.
  error     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([workOrderId, createdAt])
}

enum SuppressionReason {
  BOUNCED
  COMPLAINED
}

// Addresses that hard-bounced or marked our email as spam. Praedium never emails them again, for any organization:
// a dead mailbox is dead for everyone, and complaints hurt the sending domain for every customer.
model SuppressedEmail {
  // Trimmed and lower-cased.
  email     String            @id
  reason    SuppressionReason
  // The bounce message, when there is one.
  detail    String?
  createdAt DateTime          @default(now())
}

model Organization {
  id            String    @id @default(cuid())
  clerkOrgId    String    @unique
  name          String
  phone         String?
  email         String?
  jobNumberYear Int?
  lastJobNumber Int       @default(1000)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Set when an admin deletes the organization in Settings (restorable for 7 days) or it's deleted in Clerk
  // (webhook, which also revokes its API keys). No one can open it; the data itself is removed later by the purge job.
  deletedAt     DateTime?

  users       User[]
  properties  Property[]
  contacts    Contact[]
  tags        Tag[]
  units       Unit[]
  workOrders  WorkOrder[]
  attachments Attachment[]

  workOrderEvents WorkOrderEvent[]
  apiKeys         ApiKey[]
  memberships     Membership[]
  emailLogs       EmailLog[]
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  // Deprecated: membership and role live in Membership now. Still written on create; dropped in a later migration (two-deploy rule).
  role      UserRole @default(USER)
  firstName String?
  lastName  String?
  email     String
  // null until the user picks on the dashboard prompt or in Settings; AI is shown unless this is false.
  aiEnabled Boolean?
  // Notification options this user turned on (keys from src/lib/notificationTypes.ts). Empty means the defaults;
  // ["none"] means all turned off.
  notificationTypes String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Deprecated: membership and role live in Membership now. Still written on create; dropped in a later migration (two-deploy rule).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workOrderEvents WorkOrderEvent[]
  apiKeys         ApiKey[]
  memberships     Membership[]

  @@index([organizationId])
}

// Who belongs to which organization, and as what. Clerk is the source of truth (org membership and org:admin);
// getCurrentUser() mirrors it here on each request so the database knows the members of an organization.
model Membership {
  id        String   @id @default(cuid())
  role      UserRole @default(USER)
  // When this user last opened the notifications dropdown in this organization; newer matches count as unread.
  notificationsSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Contact {
  id           String      @id @default(cuid())
  contactType  ContactType
  displayName  String
  firstName    String?
  lastName     String?
  company      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zipCode      String?
  email        String?
  phone        String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  favorite     Boolean     @default(false)
  archived     Boolean     @default(false)
  inHouse      Boolean     @default(false) // an employee rather than an outside contractor; a label only

  contractorWorkOrders WorkOrder[]  @relation("WorkOrderContractor")
  tenantWorkOrders     WorkOrder[]  @relation("WorkOrderTenant")
  attachments          Attachment[]

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([organizationId])
}

model Property {
  id           String       @id @default(cuid())
  propertyType PropertyType
  displayName  String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zipCode      String
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  favorite     Boolean      @default(false)
  archived     Boolean      @default(false)

  workOrders  WorkOrder[]
  units       Unit[]
  attachments Attachment[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Tag {
  id        String  @id @default(cuid())
  name      String
  color     String?
  sortOrder Int     @default(0)
  archived  Boolean @default(false)

  lineItems LineItem[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Unit {
  id        String  @id @default(cuid())
  name      String
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)
  archived  Boolean @default(false)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workOrders WorkOrder[]
  contacts   Contact[]

  @@index([propertyId])
  @@index([organizationId])
}

model WorkOrder {
  id              String          @id @default(cuid())
  publicToken     String          @unique
  jobNumber       String
  status          WorkOrderStatus @default(DRAFT)
  deliveryMethod  DeliveryMethod?
  title           String
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  archived        Boolean         @default(false)
  notifyTenant    Boolean         @default(false)
  inHouse         Boolean         @default(false) // handled by the office: no contractor, no contractor link
  dueDate         DateTime?
  sentAt          DateTime?
  startedAt       DateTime? // when an in-house work order was started (it is never sent)
  completedAt     DateTime?
  closedAt        DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  completionNotes String?

  contractorId    String?
  contractor      Contact? @relation("WorkOrderContractor", fields: [contractorId], references: [id], onDelete: SetNull)
  contractorName  String?
  contractorPhone String?
  contractorEmail String?

  tenantId    String?
  tenant      Contact? @relation("WorkOrderTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  tenantName  String?
  tenantPhone String?
  tenantEmail String?

  areas       Area[]
  attachments Attachment[]
  events      WorkOrderEvent[]
  challenges  ContractorChallenge[]
  emailLogs   EmailLog[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([organizationId, jobNumber])
  @@index([organizationId])
  @@index([propertyId])
  @@index([contractorId])
  @@index([tenantId])
  @@index([status])
  @@index([unitId])
}

// The work order's activity history. One row per thing that happened; see WorkOrderEventType.
model WorkOrderEvent {
  id        String             @id @default(cuid())
  type      WorkOrderEventType
  createdAt DateTime           @default(now())

  // Who did it. Office events set actorUserId; contractor events leave it null and set byContractor.
  // actorName is copied at the time ("Justin W.", "Marcus Hill") so the log survives renames and deletes.
  // Events backfilled from older work orders have no actor.
  byContractor Boolean @default(false)
  actorName    String?
  actorUserId  String?
  actorUser    User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // Small event-specific details: item and area text, changed fields, cancel reason, delivery method.
  detail Json?

  // Stops duplicates where only one event is allowed, e.g. "opened:2026-10-23" for one open per day.
  // Null for normal events (Postgres allows any number of nulls in a unique index).
  dedupeKey String?

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, dedupeKey])
  @@index([workOrderId, createdAt])
  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model Area {
  id        String @id @default(cuid())
  name      String
  sortOrder Int    @default(0)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  lineItems LineItem[]

  @@index([workOrderId])
}

model LineItem {
  id              String           @id @default(cuid())
  priority        LineItemPriority @default(MEDIUM)
  description     String
  completed       Boolean          @default(false)
  completedAt     DateTime?
  contractorNotes String?
  sortOrder       Int              @default(0)

  tags        Tag[]
  attachments Attachment[]

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId])
}

model Attachment {
  id               String   @id @default(cuid())
  storageKey       String
  fileName         String?
  mimeType         String?
  sizeBytes        Int?
  notes            String?
  sortOrder        Int      @default(0)
  contractorUpload Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // At most one owner is set (enforced by a CHECK constraint in the migration). None set means it
  // belongs to the organization itself (its logo). The first by sortOrder is the main photo or logo.
  propertyId  String?
  property    Property?  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  lineItemId  String?
  lineItem    LineItem?  @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([workOrderId])
  @@index([lineItemId])
  @@index([contactId])
  @@index([organizationId])
}

// A key that lets an outside AI assistant (over MCP) act for one organization without a Clerk session.
// Only a hash of the key is stored; `prefix` is the first few characters, shown in Settings to tell keys apart.
model ApiKey {
  id              String    @id @default(cuid())
  name            String
  prefix          String
  keyHash         String    @unique
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  // Why Praedium revoked it (its creator left or was deleted, or the organization was deleted). Null when an admin
  // revoked it in Settings.
  revokedReason   String?
  createdAt       DateTime  @default(now())
  // Lets the key send, cancel, archive and restore work orders over MCP. Off by default.
  canChangeStatus Boolean   @default(false)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Fixed-window request counters used by src/lib/rateLimit.ts. One row per bucket (for example an API key hash, an
// IP, a user id or an organization id with a prefix). Expired rows are deleted opportunistically.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// A one-time code emailed to a work order's contractor so a browser can be verified as theirs. Only the code's
// hash is stored; the row is useless after it expires or is consumed. See src/lib/contractorVerify.ts.
model ContractorChallenge {
  id         String    @id @default(cuid())
  // The address the code went to, trimmed and lower-cased.
  email      String
  // scrypt of the 6-digit code, salted with the challenge id.
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([expiresAt])
}

// A verified contractor browser: the cookie holds a random token, only its hash is stored. Keyed by the
// contractor's email, not an organization, so one verification covers every organization that sends them work.
// expiresAt rolls forward 30 days from the last use; the database, not the cookie, decides when it ends.
model ContractorSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  // Trimmed and lower-cased.
  email      String
  remember   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?

  @@index([email])
  @@index([expiresAt])
}
